{
  "name": "feedmee",
  "version": "0.17.1",
  "description": "The seriously fast feed reader.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bunx tauri build --no-bundle",
    "build:frontend": "bunx vite build",
    "check": "svelte-kit sync ; bun run lint:types ; bun run lint:frontend ; bun run lint:backend",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "clean": "rm -rf build .context .svelte-kit node_modules bun.lock releases src-tauri/gen src-tauri/target src-tauri/Cargo.lock .pkg/src .pkg/pkg .pkg/feedmee .pkg/*.pkg.tar.zst .pkg/*.gz",
    "crates": "cd src-tauri && cargo upgrade --verbose",
    "dev": "svelte-kit sync && bunx tauri dev",
    "format": "biome format --write && cd src-tauri && cargo fmt",
    "lint:backend": "echo \"[Lint] Checking Backend...\" && cd src-tauri && cargo check && cargo clippy --all-targets --all-features -- -D warnings",
    "lint:frontend": "echo \"[Lint] Checking Frontend Syntax...\" && biome lint .",
    "lint:types": "echo \"[Lint] Checking Frontend Types...\" && svelte-check --tsconfig ./tsconfig.json",
    "package": "cd .pkg && makepkg -si --noconfirm --force",
    "repo:back": "repomix -c .repomix/repomix.src.back.json",
    "repo:front": "repomix -c .repomix/repomix.src.front.json",
    "repo:full": "repomix -c .repomix/repomix.full.json",
    "repo:skel": "repomix -c .repomix/repomix.skel.json",
    "repo:src": "repomix -c .repomix/repomix.src.json",
    "repo:tool": "repomix -c .repomix/repomix.tool.json",
    "tauri": "bunx tauri",
    "update": "bun update --latest && bun run crates && cd src-tauri && cargo generate-lockfile",
    "version": "bun scripts/version.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "dompurify": "^3.4.11",
    "lucide-svelte": "^1.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2.11.4",
    "lefthook": "^2.1.10",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "typescript": "6.0.3",
    "vite": "^8.1.4"
  },
  "overrides": {
    "typescript": "6.0.3"
  }
}
