{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "root": true,
  "files": {
    "includes": [
      "**",
      "!.assets",
      "!.context",
      "!.docs",
      "!.pkg",
      "!.svelte-kit",
      "!build",
      "!dist",
      "!node_modules",
      "!scripts",
      "!src-tauri",
      "!**/*.toml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 4,
    "lineWidth": 100,
    "lineEnding": "lf",
    "attributePosition": "auto"
  },
  "assist": {
    "enabled": true
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true,
      "lineWidth": 100,
      "indentStyle": "space",
      "indentWidth": 4,
      "lineEnding": "lf"
    }
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "bracketSameLine": true,
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "warn"
      },
      "correctness": {
        "noUnusedVariables": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["*.md", "*.yml", "*.yaml", "*.toml", "*.json"],
      "formatter": {
        "indentWidth": 2
      }
    },
    {
      "includes": ["*.svelte", "**/*.svelte"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}
