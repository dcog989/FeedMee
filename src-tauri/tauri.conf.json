{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FeedMee",
  "version": "0.22.9",
  "identifier": "com.feedmee.app",
  "build": {
    "beforeDevCommand": "bunx vite dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "svelte-kit sync && bunx vite build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "FeedMee",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/dcog989/feedmee/releases/latest/download/latest.json"
      ]
    }
  }
}
